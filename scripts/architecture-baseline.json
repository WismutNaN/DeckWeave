    },
    "deckweave-profiles": {
      "context": "Profile Store infrastructure",
      "allowedDependencies": [
        "deckweave-domain",
        "deckweave-platform",
        "deckweave-workspace"
      ]
    },
    "deckweave-registry": {
      "context": "Capability Registry",
      "allowedDependencies": ["deckweave-domain"]
    },
    "deckweave-plugin-supervisor": {
