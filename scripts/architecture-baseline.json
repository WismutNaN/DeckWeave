  "sizeExceptions": {
    "apps/desktop/src-tauri/src/main.rs": {
      "maxLines": 230,
      "owner": "Desktop composition root",
      "reason": "The initial Tauri composition root still combines command wiring, tray lifecycle and window setup.",
      "reviewMilestone": "Phase 6"
    },
    "crates/deckweave-domain/src/capability.rs": {
      "maxLines": 421,
      "owner": "Shared Kernel",
      "reason": "Existing capability vocabulary is split only after its Phase 5 consumers prove stable seams.",
      "reviewMilestone": "Phase 5"
    },
    "crates/deckweave-plugin-supervisor/src/package.rs": {
      "maxLines": 544,
      "owner": "Plugin Runtime",
      "reason": "Package validation and indexing predate the DDD module ratchet and require a dedicated extraction slice.",
      "reviewMilestone": "Phase 12"
    },
    "crates/deckweave-plugin-supervisor/src/supervisor.rs": {
      "maxLines": 735,
      "owner": "Plugin Runtime",
      "reason": "Lifecycle state and process coordination require characterization before separation.",
      "reviewMilestone": "Phase 12"
    },
    "crates/deckweave-profiles/src/draft.rs": {
      "maxLines": 537,
      "owner": "Profile Store infrastructure",
      "reason": "Append-only transactions, receipts, recovery and the session editor remain in the persistence adapter and will split around apply repositories.",
      "reviewMilestone": "Phase 4 apply"
    },
    "crates/deckweave-profiles/src/export.rs": {
      "maxLines": 427,
      "owner": "Profile Store infrastructure",
      "reason": "Portable archive encoding, integrity validation and asset publication remain colocated until a second archive format exists.",
      "reviewMilestone": "Phase 4 hardening"
    },
    "crates/deckweave-profiles/src/lib.rs": {
      "maxLines": 390,
      "owner": "Profile Store infrastructure",
      "reason": "Revision and asset filesystem methods remain in the adapter root; domain policy has moved to Workspace Configuration.",
      "reviewMilestone": "Phase 4 hardening"
    },
    "crates/deckweave-protocol/src/lib.rs": {
      "maxLines": 383,
      "owner": "Shared Kernel / Protocol",
      "reason": "Generated boundary exports and negotiation helpers predate the thin-root rule.",
      "reviewMilestone": "Phase 5"
    },
    "crates/deckweave-registry/src/lib.rs": {
      "maxLines": 391,
      "owner": "Capability Registry",
      "reason": "The initial aggregate and service share a crate root until registry use cases expand.",
      "reviewMilestone": "Phase 5"
    },
    "runtimes/openaction-host/src/lib.rs": {
      "maxLines": 258,
      "owner": "OpenAction compatibility runtime",
      "reason": "The C0 scanner and compatibility report remain together until the production host extraction.",
      "reviewMilestone": "Phase 14"
    }
  }
