      "context": "OpenAction compatibility runtime",
      "allowedDependencies": []
    },
    "deckweave-workspace": {
      "context": "Workspace Configuration",
      "allowedDependencies": ["deckweave-domain"]
    },
    "deckweave-platform": {
      "context": "Host Platform contracts",
      "allowedDependencies": ["deckweave-domain"]
    },
    "deckweave-platform-input": {
      "context": "Platform Input",
      "allowedDependencies": ["deckweave-domain"]
    },
    "deckweave-interaction": {
